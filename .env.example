# ICO IT Academy LMS — muhit o'zgaruvchilari namunasi.
# Nusxa oling: cp .env.example .env va qiymatlarni o'zgartiring. Haqiqiy sirlarni commit qilmang.

NODE_ENV=development

# --- Ilovalar ---
API_PORT=3001
WEB_PORT=3000

# --- PostgreSQL (compose.yaml) ---
POSTGRES_USER=lms
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lms
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lms:change_me@localhost:5432/lms?schema=public

# --- Redis (compose.yaml) ---
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_URL=redis://:change_me@localhost:6379/0

# --- MinIO (dev uchun S3-compatible storage, compose.yaml) ---
# MinIO parol kamida 8 belgi bo'lishi kerak.
MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me_please
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- S3-compatible object storage (ilova shu o'zgaruvchilar orqali ulanadi, S-61) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me_please
S3_BUCKET=lms-files
S3_FORCE_PATH_STYLE=true
