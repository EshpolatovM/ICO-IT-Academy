# ICO IT Academy LMS — muhit o'zgaruvchilari namunasi.
# Nusxa oling: cp .env.example .env va qiymatlarni o'zgartiring. Haqiqiy sirlarni commit qilmang.

NODE_ENV=development

# --- Ilovalar ---
API_PORT=3001
WEB_PORT=3000

# --- PostgreSQL (compose.yaml) ---
POSTGRES_USER=lms
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lms
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lms:change_me@localhost:5432/lms?schema=public

# --- Redis (compose.yaml) ---
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_URL=redis://:change_me@localhost:6379/0

# --- S3-compatible object storage (ilova shu o'zgaruvchilar orqali ulanadi, S-61) ---
# Dev: SeaweedFS S3 (compose.yaml, `s3` servisi) kalitlarni S3_ACCESS_KEY/S3_SECRET_KEY dan oladi.
# Prod: istalgan S3-compatible provayder — faqat qiymatlar o'zgaradi.
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me_please
S3_BUCKET=lms-files
S3_FORCE_PATH_STYLE=true
