# ICO IT Academy LMS — muhit o'zgaruvchilari namunasi.
# Nusxa oling: cp .env.example .env va qiymatlarni o'zgartiring. Haqiqiy sirlarni commit qilmang.

NODE_ENV=development

# --- Ilovalar ---
API_PORT=3001
WEB_PORT=3000
# Express `trust proxy`: req.ip X-Forwarded-For dan faqat shu proksilar orqali olinadi (rate limit, audit, sessiya IP).
# Qiymatlar: false | hop soni (1, 2, ...) | loopback,linklocal,uniquelocal,IP,CIDR ro'yxati. `true` qabul qilinmaydi.
# Dev: Next.js rewrites lokal proksi → loopback. Production: faqat o'z Nginx/LB manzili yoki hop soni (README).
TRUST_PROXY=loopback
# pino log darajasi: fatal | error | warn | info | debug | trace | silent (standart: info)
LOG_LEVEL=info

# --- PostgreSQL (compose.yaml) ---
POSTGRES_USER=lms
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lms
# 5433: host'dagi tizim PostgreSQL 5432 bilan to'qnashmaslik uchun
POSTGRES_PORT=5433
DATABASE_URL=postgresql://lms:change_me@localhost:5433/lms?schema=public

# --- Redis (compose.yaml) ---
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_URL=redis://:change_me@localhost:6379/0

# --- Auth (docs/02 §3, §6). Muddatlar soniyalarda; S-12 taxmini: access 15 daqiqa, refresh student 30 kun, staff 7 kun ---
# Access JWT imzo kaliti: kamida 32 belgi, tasodifiy (masalan: openssl rand -base64 48).
# Production'da `change_me` bilan boshlanadigan sirlar (shu fayldagi namunalar) rad etiladi.
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret_min_32_chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_STUDENT_SECONDS=2592000
REFRESH_TTL_STAFF_SECONDS=604800
# Refresh cookie `Secure` atributi. Dev (http) uchun false; production'da true majburiy.
COOKIE_SECURE=false
# Login rate limit: ip + login bo'yicha 5 urinish / 15 daqiqa (docs/02 §6). Urinish parol tekshiruvidan
# OLDIN sanaladi (parallel so'rovlar ham), muvaffaqiyatli kirishda hisoblagich tozalanadi.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# IP bo'yicha umumiy login limiti (password spraying / Argon2 CPU DoS): 50 muvaffaqiyatsiz urinish / 15 daqiqa.
# Muvaffaqiyatli kirish bu hisoblagichdan ayiriladi (sinf/CGNAT ortidagi ko'p foydalanuvchi uchun).
LOGIN_IP_RATE_LIMIT_MAX_ATTEMPTS=50
LOGIN_IP_RATE_LIMIT_WINDOW_SECONDS=900
# Refresh reuse grace oynasi (soniya): almashtirilgan token shu muddat ichida qayta kelsa (parallel tablar)
# sessiya bekor qilinmaydi, 401 REFRESH_SUPERSEDED. Undan keyin — reuse detection (oila bekor qilinadi).
REFRESH_REUSE_GRACE_SECONDS=30
# POST /auth/change-password: foydalanuvchi bo'yicha eski parol urinishlari — 5 / 15 daqiqa.
CHANGE_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=5
CHANGE_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900

# --- Frontend bazaviy manzili (ota-ona havolasi: ${WEB_BASE_URL}/parent?t=...) ---
WEB_BASE_URL=http://localhost:3000

# --- Web → API ichki manzil (Next.js rewrites: /api/v1/* → ${API_INTERNAL_URL}/api/v1/*) ---
# Server env, brauzerga chiqmaydi. `next build` vaqtida o'qiladi (o'zgarsa qayta build kerak).
# apps/web faqat o'z papkasidagi .env* ni o'qiydi — ildizdagi .env dan kelmaydi; build/dev buyrug'ida bering.
API_INTERNAL_URL=http://localhost:3001

# --- Ota-ona kirishi (docs/02 §5, §5.1) ---
# HMAC-SHA256 pepper (token_hash): kamida 32 belgi, tasodifiy (masalan: openssl rand -base64 48).
PARENT_TOKEN_PEPPER=change_me_to_a_long_random_pepper_min_32_chars
# parent_tokens cookie shifrlash kaliti (AES-256-GCM): aynan 32 bayt, base64 (openssl rand -base64 32).
PARENT_COOKIE_KEY=Y2hhbmdlX21lX2NoYW5nZV9tZV9jaGFuZ2VfbWVfMzI=
# Parent session (ps cookie) muddati: 12 soat, sliding.
PARENT_SESSION_TTL_SECONDS=43200
# parent_tokens cookie muddati: 180 kun (S-16).
PARENT_TOKENS_COOKIE_MAX_AGE_SECONDS=15552000
# Bitta studentdagi faol tokenlar soni (S-17). 5-bosqichda admin sozlamalariga ko'chadi.
PARENT_MAX_ACTIVE_TOKENS=3
# Exchange rate limit (IP bo'yicha): 10 urinish / 15 daqiqa; 20 ta xatodan keyin IP 1 soatga bloklanadi.
PARENT_EXCHANGE_MAX_ATTEMPTS=10
PARENT_EXCHANGE_WINDOW_SECONDS=900
PARENT_EXCHANGE_MAX_FAILURES=20
PARENT_EXCHANGE_BLOCK_SECONDS=3600

# --- Studentlarni CSV orqali import qilish (S-21, docs/12 §2) ---
# Ixtiyoriy (berilmasa — @lms/shared STUDENT_IMPORT_DEFAULT_*). Fayl hajmi (bayt): 1 MiB. Oshsa — 413.
STUDENT_IMPORT_MAX_FILE_BYTES=1048576
# Bitta importdagi ma'lumot qatorlari (sarlavhasiz) soni. Oshsa — 400 VALIDATION_ERROR.
STUDENT_IMPORT_MAX_ROWS=500

# --- S3-compatible object storage (ilova shu o'zgaruvchilar orqali ulanadi, S-61) ---
# Dev: SeaweedFS S3 (compose.yaml, `s3` servisi) kalitlarni S3_ACCESS_KEY/S3_SECRET_KEY dan oladi.
# Prod: istalgan S3-compatible provayder — faqat qiymatlar o'zgaradi.
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me_please
S3_BUCKET=lms-files
S3_FORCE_PATH_STYLE=true

# --- Super admin CLI (pnpm --filter @lms/api create-super-admin -- --phone ... --first-name ... --last-name ...) ---
# Ixtiyoriy: berilmasa parol terminalda (ko'rinmas holda) so'raladi.
# SUPER_ADMIN_PASSWORD=

# --- Dev seed (pnpm --filter @lms/api db:seed; NODE_ENV=production da ishlamaydi) ---
SEED_MENTOR_PHONE=+998900000001
SEED_MENTOR_PASSWORD=change_me1
SEED_MENTOR_FIRST_NAME=Dev
SEED_MENTOR_LAST_NAME=Mentor
SEED_STUDENT_PASSWORD=change_me1
SEED_STUDENT_FIRST_NAME=Dev
SEED_STUDENT_LAST_NAME=Student
SEED_PATH_SLUG=frontend
SEED_PATH_TITLE=Frontend
SEED_GROUP_NAME="Dev guruh"
