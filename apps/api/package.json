{
  "name": "@lms/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@lms/shared": "workspace:*",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@lms/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.9",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
