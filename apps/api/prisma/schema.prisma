// ICO IT Academy LMS — Prisma sxemasi.
// Manba: docs/11-database.md. Konvensiyalar (§0): model nomlari PascalCase, jadvallar
// `@@map` orqali snake_case ko'plikda; PK — UUID v7 (`uuid(7)`, ilova tomonida generatsiya),
// katta append-only jadvallar — bigint identity; vaqt — timestamptz; indekslar `idx_<table>_<cols>`,
// unique — `uq_<table>_<cols>`.
//
// Prisma ifodalay olmaydigan narsalar (CHECK, sequence, pg_trgm GIN ifoda-indeksi, partial index)
// migratsiya SQL faylida qo'lda yozilgan va izohlangan.

generator client {
  provider            = "prisma-client"
  output              = "../src/infra/prisma/generated"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enum'lar
// ---------------------------------------------------------------------------

/// Akkauntli rollar (docs/11 §1 `users.role`). PARENT — virtual rol, akkaunti yo'q (docs/01 §1),
/// shuning uchun DB enum'iga kirmaydi.
enum Role {
  SUPER_ADMIN
  ADMIN
  MENTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

/// docs/11 §11 `files.purpose`.
enum FilePurpose {
  AVATAR
  BLOG_IMAGE
  CHAT_ATTACHMENT
  MATERIAL
  PROJECT_IMAGE
  CERTIFICATE
  PRODUCT_IMAGE
  CONTENT
  EXPORT
}

/// docs/11 §3: kontent holati (yo'llar, bo'limlar, mavzular, darslar, savollar).
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// docs/11 §3 `topic_progress.status`. `LOCKED` yozilmaydi (qator yo'q = locked) — CHECK
/// `chk_topic_progress_status_not_locked`; enum'da API holatlari bilan bir xil bo'lishi uchun bor.
enum TopicStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

/// docs/11 §3 `lesson_progress.status`.
enum LessonProgressStatus {
  IN_PROGRESS
  COMPLETED
}

/// docs/11 §2 `groups.status`.
enum GroupStatus {
  ACTIVE
  ARCHIVED
}

/// docs/11 §11 `files.status`: pre-signed upload tasdiqlanguncha PENDING.
enum FileStatus {
  PENDING
  READY
}

// ---------------------------------------------------------------------------
// 1. Auth va foydalanuvchilar (docs/11 §1)
// ---------------------------------------------------------------------------

/// Barcha akkauntli rollar bitta jadvalda. Soft delete: `deleted_at`.
/// Migratsiyada: CHECK `chk_users_login_by_role`, GIN `idx_users_full_name_trgm`, `student_code_seq`.
model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  role               Role
  /// E.164. Staff uchun majburiy (CHECK).
  phone              String?    @db.VarChar(16)
  /// `ST-10001`. Student uchun majburiy (CHECK), raqam `student_code_seq` dan.
  studentCode        String?    @map("student_code") @db.VarChar(16)
  /// Argon2id.
  passwordHash       String     @map("password_hash")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  tokenVersion       Int        @default(0) @map("token_version")
  firstName          String     @map("first_name") @db.VarChar(64)
  lastName           String     @map("last_name") @db.VarChar(64)
  avatarFileId       String?    @map("avatar_file_id") @db.Uuid
  bio                String?    @db.VarChar(500)
  status             UserStatus
  blogBannedUntil    DateTime?  @map("blog_banned_until") @db.Timestamptz
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz
  lastSeenAt         DateTime?  @map("last_seen_at") @db.Timestamptz
  createdById        String?    @map("created_by_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz

  avatarFile   File?  @relation("UserAvatar", fields: [avatarFileId], references: [id])
  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[] @relation("UserCreatedBy")

  refreshTokens         RefreshToken[]
  parentTokensAsStudent ParentAccessToken[]     @relation("ParentTokenStudent")
  parentTokensCreated   ParentAccessToken[]     @relation("ParentTokenCreatedBy")
  parentTokensRevoked   ParentAccessToken[]     @relation("ParentTokenRevokedBy")
  parentAccessLogs      ParentAccessLog[]
  auditLogs             AuditLog[]
  ownedFiles            File[]                  @relation("FileOwner")
  updatedSystemSettings SystemSetting[]
  mentoredGroups        Group[]                 @relation("GroupMentor")
  groupMemberships      GroupMember[]           @relation("GroupMemberStudent")
  pathEnrollments       StudentPathEnrollment[]
  topicProgress         TopicProgress[]
  lessonProgress        LessonProgress[]

  @@unique([phone], map: "uq_users_phone")
  @@unique([studentCode], map: "uq_users_student_code")
  @@index([role, status], map: "idx_users_role_status")
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// SHA-256 (hex).
  tokenHash    String    @map("token_hash") @db.Char(64)
  /// Rotation zanjiri (reuse detection).
  familyId     String    @map("family_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar(256)
  ip           String?   @db.Inet
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user       User           @relation(fields: [userId], references: [id])
  replacedBy RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedById], references: [id])
  replaces   RefreshToken[] @relation("RefreshTokenRotation")

  @@unique([tokenHash], map: "uq_refresh_tokens_token_hash")
  @@index([userId, revokedAt], map: "idx_refresh_tokens_user_id_revoked_at")
  @@index([familyId], map: "idx_refresh_tokens_family_id")
  @@map("refresh_tokens")
}

/// Har bir farzand uchun alohida token (S-15). Migratsiyada partial index
/// `idx_parent_access_tokens_student_id_active` (`WHERE revoked_at IS NULL`).
model ParentAccessToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  /// HMAC-SHA256(pepper, token) (hex).
  tokenHash   String    @map("token_hash") @db.Char(64)
  /// UI va log uchun.
  tokenPrefix String    @map("token_prefix") @db.VarChar(8)
  label       String?   @db.VarChar(64)
  createdById String    @map("created_by_id") @db.Uuid
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  useCount    Int       @default(0) @map("use_count")
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  revokedById String?   @map("revoked_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  student   User  @relation("ParentTokenStudent", fields: [studentId], references: [id])
  createdBy User  @relation("ParentTokenCreatedBy", fields: [createdById], references: [id])
  revokedBy User? @relation("ParentTokenRevokedBy", fields: [revokedById], references: [id])

  logs ParentAccessLog[]

  @@unique([tokenHash], map: "uq_parent_access_tokens_token_hash")
  @@map("parent_access_tokens")
}

/// Append-only: `bigint identity` PK.
model ParentAccessLog {
  id        BigInt   @id @default(autoincrement())
  tokenId   String   @map("token_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  ip        String   @db.Inet
  userAgent String   @map("user_agent") @db.VarChar(256)
  /// `EXCHANGE`, `VIEW`.
  action    String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  token   ParentAccessToken @relation(fields: [tokenId], references: [id])
  student User              @relation(fields: [studentId], references: [id])

  @@index([tokenId, createdAt(sort: Desc)], map: "idx_parent_access_logs_token_id_created_at")
  @@map("parent_access_logs")
}

/// Append-only: `bigint identity` PK.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  Role?    @map("actor_role")
  /// `USER_CREATED`, `PASSWORD_RESET`, `PARENT_TOKEN_REVOKED`, `WALLET_ADJUSTED`, `SETTING_CHANGED`, ...
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(32)
  entityId   String   @map("entity_id") @db.VarChar(64)
  before     Json?
  after      Json?
  ip         String?  @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId], map: "idx_audit_logs_entity_type_entity_id")
  @@index([actorId, createdAt(sort: Desc)], map: "idx_audit_logs_actor_id_created_at")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// 2. Guruhlar (docs/11 §2). S-01 B: guruh bitta yo'lni o'qiydi; S-02 A: bitta faol guruh;
// S-03 A: bitta mentor.
// ---------------------------------------------------------------------------

/// Soft delete: `deleted_at`.
model Group {
  id        String      @id @default(uuid(7)) @db.Uuid
  name      String      @db.VarChar(64)
  /// Guruh o'qiydigan yo'l (S-01).
  pathId    String      @map("path_id") @db.Uuid
  /// Bitta mentor (S-03).
  mentorId  String?     @map("mentor_id") @db.Uuid
  status    GroupStatus
  startsAt  DateTime?   @map("starts_at") @db.Date
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz

  path   LearningPath @relation(fields: [pathId], references: [id])
  mentor User?        @relation("GroupMentor", fields: [mentorId], references: [id])

  members GroupMember[]

  @@index([mentorId, status], map: "idx_groups_mentor_id_status")
  @@map("groups")
}

/// A'zolik tarixi: guruhdan chiqqanda `left_at` to'ldiriladi (yozuv o'chirilmaydi).
/// Migratsiyada: partial unique `uq_group_members_active_student` (`student_id` WHERE
/// `left_at IS NULL`, S-02) va partial index `idx_group_members_group_id_active`.
model GroupMember {
  id        String    @id @default(uuid(7)) @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  leftAt    DateTime? @map("left_at") @db.Timestamptz

  group   Group @relation(fields: [groupId], references: [id])
  student User  @relation("GroupMemberStudent", fields: [studentId], references: [id])

  @@map("group_members")
}

// ---------------------------------------------------------------------------
// 3. Ilm yo'li (docs/11 §3). Kontent ierarxiyasi ichida `onDelete: Cascade`
// (yo'l → bo'lim → mavzu → dars; bo'lim → sandiq; mavzu/ko'nikma → topic_skills); progress va
// enrollment'dan kontentga va `users` ga `Restrict` (tarix himoyasi). Soft delete yo'q: kontent
// `status = ARCHIVED` bo'ladi. `ContentStatus` uchun DB default yo'q (servis `DRAFT` yozadi).
// `(…, "order")` unique'lari migratsiyada DEFERRABLE INITIALLY IMMEDIATE constraint (qo'lda SQL).
// Raw SQL'da `order` ustuni qo'shtirnoqda yoziladi: `"order"`.
// ---------------------------------------------------------------------------

model LearningPath {
  id          String        @id @default(uuid(7)) @db.Uuid
  title       String        @db.VarChar(128)
  slug        String        @db.VarChar(128)
  description String?
  coverFileId String?       @map("cover_file_id") @db.Uuid
  status      ContentStatus
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  coverFile File? @relation("LearningPathCover", fields: [coverFileId], references: [id])

  groups      Group[]
  sections    PathSection[]
  enrollments StudentPathEnrollment[]

  @@unique([slug], map: "uq_learning_paths_slug")
  @@map("learning_paths")
}

/// Migratsiyada `uq_path_sections_path_id_order` — DEFERRABLE INITIALLY IMMEDIATE constraint.
model PathSection {
  id          String        @id @default(uuid(7)) @db.Uuid
  pathId      String        @map("path_id") @db.Uuid
  /// Yo'l ichidagi tartib.
  order       Int
  title       String        @db.VarChar(128)
  description String?
  status      ContentStatus
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  topics Topic[]
  chests PathChest[]

  @@unique([pathId, order], map: "uq_path_sections_path_id_order")
  @@map("path_sections")
}

/// Migratsiyada `uq_topics_section_id_order` — DEFERRABLE INITIALLY IMMEDIATE constraint.
/// `pass_threshold` (S-31) 4-bosqichda alohida migratsiya bilan qo'shiladi.
model Topic {
  id          String        @id @default(uuid(7)) @db.Uuid
  sectionId   String        @map("section_id") @db.Uuid
  /// Bo'lim ichidagi tartib.
  order       Int
  title       String        @db.VarChar(128)
  description String?
  icon        String?       @db.VarChar(64)
  status      ContentStatus
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  section PathSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  lessons    Lesson[]
  chestAfter PathChest?
  skills     TopicSkill[]
  progress   TopicProgress[]

  @@unique([sectionId, order], map: "uq_topics_section_id_order")
  @@map("topics")
}

/// Migratsiyada `uq_lessons_topic_id_order` — DEFERRABLE INITIALLY IMMEDIATE constraint.
/// `updated_at` — S-35 bo'yicha yagona "versiya" belgisi.
model Lesson {
  id         String        @id @default(uuid(7)) @db.Uuid
  topicId    String        @map("topic_id") @db.Uuid
  /// Mavzu ichidagi tartib.
  order      Int
  title      String        @db.VarChar(128)
  /// Markdown. DB default yo'q (bo'sh qoralama uchun servis `''` yozadi).
  contentMd  String        @map("content_md")
  /// Faqat `https:` — DTO'da tekshiriladi, DB'da CHECK yo'q.
  videoUrl   String?       @map("video_url") @db.VarChar(512)
  estMinutes Int?          @map("est_minutes") @db.SmallInt
  status     ContentStatus
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  progress LessonProgress[]

  @@unique([topicId, order], map: "uq_lessons_topic_id_order")
  @@map("lessons")
}

/// Mukofot sandig'i: bitta mavzudan keyin bitta sandiq. `status` yo'q — ko'rinishi `after_topic`
/// ko'rinishiga bog'liq (TL Q-1). `after_topic_id` → `NoAction`: mavzuni yolg'iz o'chirish xato
/// beradi, bo'lim kaskadida esa statement oxirida tekshirilgani uchun o'tadi.
/// `section_id = after_topic.section_id` mosligini servis tekshiradi.
model PathChest {
  id           String   @id @default(uuid(7)) @db.Uuid
  sectionId    String   @map("section_id") @db.Uuid
  afterTopicId String   @map("after_topic_id") @db.Uuid
  title        String   @db.VarChar(64)
  /// `{ "xp": {"min","max"}, "coin": {"min","max"} }` (S-26 A); qat'iy qiymat = `min = max`.
  /// Sxema zod'da (`@lms/shared`), DB'da tekshirilmaydi. 5-bosqichgacha hech narsa bermaydi.
  reward       Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  section    PathSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  afterTopic Topic       @relation(fields: [afterTopicId], references: [id], onDelete: NoAction)

  @@unique([afterTopicId], map: "uq_path_chests_after_topic_id")
  @@index([sectionId], map: "idx_path_chests_section_id")
  @@map("path_chests")
}

model Skill {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(64)
  icon      String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  topics TopicSkill[]

  @@unique([name], map: "uq_skills_name")
  @@map("skills")
}

model TopicSkill {
  topicId String @map("topic_id") @db.Uuid
  skillId String @map("skill_id") @db.Uuid

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([topicId, skillId], map: "topic_skills_pkey")
  @@index([skillId], map: "idx_topic_skills_skill_id")
  @@map("topic_skills")
}

/// Lazy enrollment (TL Q-5): student `/student/*` ga birinchi murojaat qilganda 3.3 servisi
/// `createMany({ skipDuplicates: true })` bilan yozadi. `uq_..._student_id_path_id` — idempotentlik
/// kafolati. "Joriy yo'l" saqlanmaydi — `groups.path_id` dan hisoblanadi.
model StudentPathEnrollment {
  id          String    @id @default(uuid(7)) @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  pathId      String    @map("path_id") @db.Uuid
  /// Studentning shu yo'lga birinchi murojaati vaqti.
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  student User         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  path    LearningPath @relation(fields: [pathId], references: [id], onDelete: Restrict)

  @@unique([studentId, pathId], map: "uq_student_path_enrollments_student_id_path_id")
  @@index([pathId], map: "idx_student_path_enrollments_path_id")
  @@map("student_path_enrollments")
}

/// Qator yo'q = `LOCKED`. Migratsiyada CHECK'lar: `chk_topic_progress_status_not_locked`,
/// `chk_topic_progress_completed_at` (`completed_at` faqat va albatta `COMPLETED` da) —
/// `status` va `completed_at` bitta statement'da yoziladi.
model TopicProgress {
  studentId        String      @map("student_id") @db.Uuid
  topicId          String      @map("topic_id") @db.Uuid
  status           TopicStatus
  lessonsCompleted Int         @default(0) @map("lessons_completed") @db.SmallInt
  /// 4-bosqich (savollar) to'ldiradi.
  firstTryCorrect  Int         @default(0) @map("first_try_correct")
  /// 4-bosqich (savollar) to'ldiradi.
  firstTryTotal    Int         @default(0) @map("first_try_total")
  startedAt        DateTime?   @map("started_at") @db.Timestamptz
  completedAt      DateTime?   @map("completed_at") @db.Timestamptz
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  student User  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([studentId, topicId], map: "topic_progress_pkey")
  @@index([studentId, status], map: "idx_topic_progress_student_id_status")
  @@index([topicId, status], map: "idx_topic_progress_topic_id_status")
  @@map("topic_progress")
}

/// Migratsiyada CHECK `chk_lesson_progress_completed_at`. Qator mavjudligi = dars boshlangan
/// (6-bosqich blok qoidasi).
model LessonProgress {
  studentId   String               @map("student_id") @db.Uuid
  lessonId    String               @map("lesson_id") @db.Uuid
  status      LessonProgressStatus
  startedAt   DateTime             @default(now()) @map("started_at") @db.Timestamptz
  completedAt DateTime?            @map("completed_at") @db.Timestamptz

  student User   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@id([studentId, lessonId], map: "lesson_progress_pkey")
  @@index([studentId, completedAt], map: "idx_lesson_progress_student_id_completed_at")
  @@map("lesson_progress")
}

// ---------------------------------------------------------------------------
// 6. Sozlamalar (docs/11 §6 `reward_settings` tuzilmasi; `system_settings` — faqat super admin)
// ---------------------------------------------------------------------------

model SystemSetting {
  key         String   @id @db.VarChar(96)
  value       Json
  group       String   @db.VarChar(32)
  description String
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// 11. Fayllar (docs/11 §11)
// ---------------------------------------------------------------------------

model File {
  id        String      @id @default(uuid(7)) @db.Uuid
  ownerId   String?     @map("owner_id") @db.Uuid
  /// `public` / `private`.
  bucket    String      @db.VarChar(32)
  /// Object storage kaliti.
  key       String      @db.VarChar(256)
  mime      String      @db.VarChar(96)
  sizeBytes Int         @map("size_bytes")
  purpose   FilePurpose
  status    FileStatus
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  owner              User?          @relation("FileOwner", fields: [ownerId], references: [id])
  avatarOfUsers      User[]         @relation("UserAvatar")
  learningPathCovers LearningPath[] @relation("LearningPathCover")

  @@unique([key], map: "uq_files_key")
  @@index([ownerId, purpose], map: "idx_files_owner_id_purpose")
  @@map("files")
}
